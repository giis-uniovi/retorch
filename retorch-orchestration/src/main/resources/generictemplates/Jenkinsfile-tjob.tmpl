stage('${TJOB} IdResource: ${RESOURCES}') {
  steps {
    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
      sh '$SCRIPTS_FOLDER/tjoblifecycles/tjob-setup.sh ${TJOB} ${STAGE} ${APP_URL}'
      sh '$SCRIPTS_FOLDER/tjoblifecycles/tjob-testexecution.sh ${TJOB} ${STAGE} ${APP_URL} "${TESTS}"'
    }// EndExecutionStageError${TJOB}
    sh '$SCRIPTS_FOLDER/tjoblifecycles/tjob-teardown.sh ${TJOB} ${STAGE}'
  }// EndSteps${TJOB}
}// EndStage${TJOB}
